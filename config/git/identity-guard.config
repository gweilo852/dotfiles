# Managed by dotfiles (./install.sh --repos). Included for repositories
# under ~/projects/personal/ and ~/projects/work/ (and their worktrees),
# before your local identity file for that scope. It clears any identity
# from ~/.gitconfig, so a scope without its own identity file cannot fall
# back to the other scope's identity: with user.useConfigOnly, git refuses
# to commit ("Author identity unknown") until the scope file exists.
[user]
	name =
	email =
