# ~/.zshrc: managed by dotfiles (https://github.com/gweilo852/dotfiles).
# Do not edit this file for one machine. Put machine-specific settings,
# work settings and secrets in ~/.zshrc.local, which is never managed.
# Reload with: exec zsh

# Repository root, from this file's real path (~/.zshrc is a symlink).
typeset -g DOTFILES_DIR=${${(%):-%x}:A:h:h:h}

# --------------------------------------------------------------------
# Environment and PATH
# --------------------------------------------------------------------

# Keep PATH and fpath free of duplicates, whatever adds to them.
typeset -U path fpath

if [[ -z $HOMEBREW_PREFIX ]]; then
  for _b in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    [[ -x $_b ]] && { eval "$($_b shellenv)"; break; }
  done
  unset _b
fi

# Prepend user tool directories that exist. (N-/) drops missing ones.
path=(
  $HOME/bin(N-/) $HOME/.local/bin(N-/) ${KREW_ROOT:-$HOME/.krew}/bin(N-/)
  $DOTFILES_DIR/.local/bin(N-/)
  $path
)

for _f in $HOME/google-cloud-sdk/path.zsh.inc \
  ${HOMEBREW_PREFIX:+$HOMEBREW_PREFIX/share/google-cloud-sdk/path.zsh.inc}; do
  [[ -r $_f ]] && { source $_f; break; }
done
unset _f

source $DOTFILES_DIR/config/shell/env.sh

# --------------------------------------------------------------------
# Options and history
# --------------------------------------------------------------------

HISTFILE=$HOME/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY       # save timestamps and durations
setopt SHARE_HISTORY          # share history between open shells
setopt HIST_IGNORE_DUPS       # skip a command that repeats the previous one
setopt HIST_IGNORE_SPACE      # skip commands that start with a space
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY            # show !! expansions before they run
setopt INTERACTIVE_COMMENTS
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT
setopt NO_BEEP

bindkey -e                    # emacs keys, the zsh default
WORDCHARS=${WORDCHARS//[\/]}  # Alt+Backspace stops at a slash

# --------------------------------------------------------------------
# Completion, aliases, local settings, then plugins and the prompt
# --------------------------------------------------------------------

source $DOTFILES_DIR/config/zsh/completion.zsh
source $DOTFILES_DIR/config/shell/aliases.sh
source $DOTFILES_DIR/config/shell/tmux.sh
alias reload='exec zsh'

# Machine-specific settings. Loaded after compinit, so compdef works here,
# and before the plugins, so plugin variables set here take effect.
[[ -r $HOME/.zshrc.local ]] && source $HOME/.zshrc.local

source $DOTFILES_DIR/config/zsh/plugins.zsh
